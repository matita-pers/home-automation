{
  "version": 2,
  "builds": [
    {
      "src": "backend/app.py",
      "use": "@vercel/python"
    }
  ],
  "routes": [
    {
      "src": "/",
      "dest": "/static/html/index.html"
    },
    {
      "src": "/(.*\\.html)",
      "dest": "/static/html/$1"
    },
    {
      "src": "/(?:js/)?(.*\\.js)",
      "dest": "/static/js/$1"
    },
    {
      "src": "/(?:css/)?(.*\\.css)",
      "dest": "/static/css/$1"
    },
    {
      "src": "/(?:images?/|img/)?(.*\\.(png|jpg|jpeg|gif|svg|webp|ico))",
      "dest": "/static/images/$1"
    },
    {
      "src": "/(.*)",
      "dest": "backend/app.py"
    }
  ]
}