# gh app client ID
GITHUB_APP_ID=
# the content of the secret key, quote it.
GITHUB_APP_KEY=
# the installation id, obtained from /users/{username}/installation, /repos/{owner}/{repo}/installation, /orgs/{org}/installation, or /app/installations
GITHUB_INSTALLATION_ID=
# the repo in which to create issues
GITHUB_REPO=
# the owner of the repo
GITHUB_OWNER=
# the db password
DATABASE_PASSWORD=
# thsi is the secret used in the JWT-like for auth (itzdangerous)
FLASK_SECRET_KEY=
# the port the webserver is on
PORT=80
